{
  "name": "gc-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "dev:api": "cargo run --manifest-path ../gc-api/Cargo.toml",
    "dev:db": "docker start gcapi-dev-pg 2>/dev/null || docker run -d --name gcapi-dev-pg -p 55432:5432 -e POSTGRES_PASSWORD=dev -e POSTGRES_DB=gcapi postgres:18-alpine",
    "dev:stack": "concurrently -k -n db,api,web -c yellow,blue,green \"npm run dev:db\" \"npm run dev:api\" \"vp dev\"",
    "dev:down": "docker stop gcapi-dev-pg",
    "build": "tsc && vp build",
    "preview": "vp preview",
    "prepare": "vp config"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.42",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "happy-dom": "^20.14.6",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.2.0",
      "onFail": "download"
    }
  }
}
